<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>Script class_06</title>
		<script>
			function show(){
				window.alert("메뉴: 짜장면 금액: 6000원 감사합니다.");
			}
		</script>
	</head>
	<body>
		<h1>중국집 프로그램 리뉴얼</h1>
		<input type="button" value="짜장면" onclick="show()">
		<input type="button" value="짬뽕">
		<input type="button" value="탕수육">
		<input type="button" value="팔보채">
	</body>
</html>